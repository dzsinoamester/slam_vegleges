    <script>
        var audio = new Audio('https://stream.zeno.fm/dglbc1ohnzmuv'); // Ganti 'nama_file_audio.mp3' dengan URL atau path ke file audio yang ingin Anda mainkan
        var playPauseButton = document.getElementById('playPauseButton');
        var volumeControl = document.querySelector('.volume-control');
        var volumeBar = document.querySelector('.volume-bar');
        var volumeBarHandle = document.querySelector('.volume-bar-handle');
        var isDraggingVolume = false;

        function playPause() {
            if (audio.paused) {
                audio.play();
                playPauseButton.innerHTML = '<i class="fas fa-pause"></i>';
            } else {
                audio.pause();
                playPauseButton.innerHTML = '<i class="fas fa-play"></i>';
            }
        }

        function setVolume(event) {
            var volumeBarRect = volumeControl.getBoundingClientRect();
            var volume = (event.clientX - volumeBarRect.left) / volumeBarRect.width;
            volume = Math.max(0, Math.min(1, volume)); // Pastikan nilai volume berada dalam rentang 0 hingga 1
            audio.volume = volume;
            updateVolumeBar(volume);
        }

        function updateVolumeBar(volume) {
            volumeBar.style.width = volume * 100 + '%';
            volumeBarHandle.style.left = volume * 100 + '%';
        }

        volumeBarHandle.addEventListener('mousedown', function(event) {
            isDraggingVolume = true;
            volumeControl.classList.add('dragging');
            updateVolume(event.clientX);
        });

        document.addEventListener('mousemove', function(event) {
            if (isDraggingVolume) {
                updateVolume(event.clientX);
            }
        });

        document.addEventListener('mouseup', function(event) {
            if (isDraggingVolume) {
                isDraggingVolume = false;
                volumeControl.classList.remove('dragging');
            }
        });

        function updateVolume(clientX) {
            var volumeBarRect = volumeControl.getBoundingClientRect();
            var volume = (clientX - volumeBarRect.left) / volumeBarRect.width;
            volume = Math.max(0, Math.min(1, volume)); // Pastikan nilai volume berada dalam rentang 0 hingga 1
            audio.volume = volume;
            updateVolumeBar(volume);
        }

        audio.addEventListener('timeupdate', function() {
            var progress = (audio.currentTime / audio.duration) * 100;
            progressBar.style.width = progress + '%';
        });

        audio.addEventListener('ended', function() {
            playPauseButton.innerHTML = '<i class="fas fa-play"></i>';
            progressBar.style.width = '0';
        });
    </script>

